# Proxmox Host Configuration
PROXMOX_HOST=your_proxmox_host_ip
PROXMOX_USER=root
PROXMOX_PASSWORD=your_proxmox_root_password_here

# SSH Connection Details
# Path to the private key used for authentication on Proxmox and the guest container
SSH_KEY_PATH=C:/Users/your_local_username/.ssh/your_ssh_key

# LXC/VM Target Configuration
# The ID of the LXC container or VM running the NPU tools
NPU_TARGET_ID=your_vm_or_container_id

# The IP address of the NPU container/VM
NPU_IP=your_target_npu_ip
NPU_PORT=8000
NPU_USER=your_npu_username
